# ============================================================
# coati 环境变量示例
# 复制此文件为 .env.development 或 .env.production 后填写真实值
# 注意：.env.development / .env.production 已加入 .gitignore，请勿提交真实密钥
# ============================================================

# ── 运行环境 ──────────────────────────────────────────────────────────
# 可选值: development | production | testing
FLASK_ENV=development

# ── 安全 ─────────────────────────────────────────────────────────────
# 随机长字符串，生产环境务必替换
SECRET_KEY=

# ── 数据库 ───────────────────────────────────────────────────────────
# 开发环境（FLASK_ENV=development 时读取）
DEV_DATABASE_URL=

# 生产环境（FLASK_ENV=production 时读取）
DATABASE_URL=

# ── 管理员账号 ────────────────────────────────────────────────────────
# init_rbac_data.py 初始化时使用
ADMIN_PASSWORD=

# ── AI / Agent 网关（OpenAI 兼容上游）────────────────────────────────
# 独立的上游凭证加密密钥；生产环境必须配置，修改后已有密文将无法解密。
AGENT_CREDENTIAL_ENCRYPTION_KEY=
# 主路径：在管理后台「Agent → 上游 Key」维护多把 Key（推荐，支持权重分流）。
# 下列 AI_* / AGENT_LLM_* 仅作紧急兜底 / 可选；Key 池为空且未配环境变量时网关不可用。
# 优先读 AGENT_LLM_*，未填时回退 AI_*。
# AGENT_LLM_KEY / AI_API_KEY
# AGENT_LLM_BASE / AI_API_BASE   如 https://api.deepseek.com
# AGENT_LLM_MODEL / AI_MODEL     环境回退使用的实际模型名；不配置时不会猜测模型
AI_API_KEY=
AI_API_BASE=
AI_MODEL=
# 兼容旧部署的部署级模型能力兜底；新配置请在后台「模型网关 → 模型能力」统一维护。
# 同一个模型只配置一份，模型账号/模型渠道只填写支持模型与映射，不配置能力。
# AGENT_MODEL_PROFILES='{"your-model":{"context_window":1000000,"max_output_tokens":32768}}'
# LiteLLM 默认能力源：后台会按缓存周期自动同步，管理员覆盖不会被同步覆盖。
# AGENT_LITELLM_AUTO_SYNC_ENABLED=true
# AGENT_LITELLM_MODEL_CATALOG_URL=https://raw.githubusercontent.com/BerriAI/litellm/main/model_prices_and_context_window.json
# AGENT_LITELLM_SYNC_INTERVAL_SECONDS=86400
# AGENT_LITELLM_SYNC_TIMEOUT_SECONDS=10

# AGENT_DAILY_TOKEN_QUOTA   每用户每日 token 上限，0=不限制
# AGENT_TIMEZONE            用量自然日与趋势统计时区
# AGENT_MIN_CLI_VERSION     CLI 最低版本
# AGENT_PLUGIN_ALLOWLIST    逗号分隔允许的插件包名
# AGENT_PUBLIC_API_BASE     对外 API 根（bootstrap 返回）
AGENT_LLM_KEY=
AGENT_LLM_BASE=
AGENT_LLM_MODEL=
AGENT_DAILY_TOKEN_QUOTA=0
AGENT_QUOTA_DEFAULT_MAX_OUTPUT_TOKENS=4096
AGENT_QUOTA_RESERVATION_TTL_SECONDS=3600
AGENT_TIMEZONE=Asia/Shanghai
AGENT_MIN_CLI_VERSION=0.0.0
AGENT_PLUGIN_ALLOWLIST=
AGENT_PUBLIC_API_BASE=
AGENT_WEBSEARCH_PROVIDER=
AGENT_WEBSEARCH_API_KEY=
AGENT_WEBSEARCH_PROXY_URL=
AGENT_WEBSEARCH_TIMEOUT_SECONDS=15
AGENT_GATEWAY_MAX_ATTEMPTS=3
# 新会话选号候选池；不影响实际故障转移次数
AGENT_GATEWAY_SELECTION_POOL_SIZE=7
AGENT_SESSION_AFFINITY_ENABLED=true
AGENT_SESSION_AFFINITY_TTL_SECONDS=3600
AGENT_CREDENTIAL_FAILURE_THRESHOLD=3
AGENT_CREDENTIAL_COOLDOWN_SECONDS=60
AGENT_CREDENTIAL_UNHEALTHY_RETRY_SECONDS=300
AGENT_ACTIVE_REQUEST_STALE_SECONDS=900
AGENT_DEVICE_STARTS_PER_MINUTE=60
AGENT_DEVICE_MAX_ACTIVE=5000
AGENT_DEVICE_RETENTION_HOURS=24

# ── 定时任务调度 ──────────────────────────────────────────────────────
# ENABLE_TASK_SCHEDULER            是否启用后台定时任务，true/false
# TASK_SCHEDULER_INTERVAL_SECONDS  扫描间隔（秒），默认 20
# TASK_SCHEDULER_LEASE_SECONDS     任务锁租约（秒），防止重复执行，默认 1800
# RUN_SCHEDULER_IN_WEB             是否在 Web 进程中运行调度器（多进程部署时建议 false）
ENABLE_TASK_SCHEDULER=
TASK_SCHEDULER_INTERVAL_SECONDS=
TASK_SCHEDULER_LEASE_SECONDS=
RUN_SCHEDULER_IN_WEB=

# ── AI SQL 只读账号（生产 compose 必填）─────────────────────────────
# POSTGRES_RO_PASSWORD  只读账号密码，docker-entrypoint 会用它在 DB 里创建
#                       coati_ro（非超级用户，仅业务表 SELECT）。
#                       setup.sh 会自动生成随机值。
# AI_SQL_DATABASE_URL   只读连接串，生产 compose 自动拼接为
#                       postgresql://coati_ro:<POSTGRES_RO_PASSWORD>@db/coati，
#                       通常无需手工填写。
# AI_SQL_STATEMENT_TIMEOUT_MS  AI SQL 单条语句超时（毫秒），默认 5000
POSTGRES_RO_PASSWORD=
AI_SQL_DATABASE_URL=
AI_SQL_STATEMENT_TIMEOUT_MS=5000

# ── 会话安全 ───────────────────────────────────────────────────────
# SESSION_COOKIE_SECURE   true/false/留空=auto（auto 仅在 HTTPS 下给 Cookie 打 Secure 标志）
# SESSION_TTL_HOURS       会话有效期（小时），默认 8
SESSION_COOKIE_SECURE=
SESSION_TTL_HOURS=8
