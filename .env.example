# Coati Node gateway. Do not reuse a Python database or Docker volume.
DEV_DATABASE_URL=postgresql://localhost/coati_node_dev
TEST_DATABASE_URL=postgresql://localhost/coati_node_test
PORT=5004
# Production requires independent random secrets; keep the encryption key backed up.
SECRET_KEY=
GATEWAY_ENCRYPTION_KEY=
ADMIN_PASSWORD=
# Opt in only when you intend to connect to private network model servers.
GATEWAY_ALLOW_PRIVATE_UPSTREAMS=false
ENABLE_TASK_SCHEDULER=false

# Standalone worker only: opt in to low-frequency saved-account recovery probes.
GATEWAY_ENABLE_PROBES=false

# Business-day boundary, matching the Python gateway default.
AGENT_TIMEZONE=Asia/Shanghai

# Shared default per-user daily tokens; zero means unlimited.
AGENT_DAILY_TOKEN_QUOTA=0

# Shared device-authorization admission across replicas.
AGENT_DEVICE_STARTS_PER_MINUTE=60
AGENT_DEVICE_MAX_ACTIVE=5000
AGENT_DEVICE_RETENTION_HOURS=24

# Comma-separated proxy IPs/CIDRs allowed to supply forwarded client IP/protocol.
# Empty for direct connections. Restrict to your reverse proxy; never trust arbitrary clients.
TRUSTED_PROXIES=

# Optional search service and credential rotation read keys.
GATEWAY_PREVIOUS_ENCRYPTION_KEYS=[]
GATEWAY_TRUSTED_PROXY_URL=
AGENT_WEBSEARCH_PROVIDER=
AGENT_WEBSEARCH_API_KEY=
AGENT_WEBSEARCH_PROXY_URL=
AGENT_WEBSEARCH_TIMEOUT_SECONDS=15

# Legacy Python environment fallback (all three required; never imported into account storage).
# AGENT_LLM_KEY=
# AGENT_LLM_BASE=https://provider.example/v1
# AGENT_LLM_MODEL=
# AI_API_KEY / AI_API_BASE / AI_MODEL are supported legacy aliases.
# AGENT_QUOTA_DEFAULT_MAX_OUTPUT_TOKENS=4096
# AGENT_QUOTA_MIN_COMPLETION_HEADROOM=0
# AGENT_DEVICE_TTL_SECONDS=600
# AGENT_DEVICE_INTERVAL_SECONDS=5
# AGENT_DEVICE_VERIFY_PATH=/agent/device-confirm

# Recovery probes run only in the standalone worker, explicitly enabled.
# GATEWAY_ENABLE_PROBES=true (takes precedence over AGENT_CREDENTIAL_PROBE_ENABLED)
# AGENT_CREDENTIAL_PROBE_INTERVAL_SECONDS=300
# AGENT_CREDENTIAL_PROBE_BATCH_LIMIT=5
# AGENT_CREDENTIAL_PROBE_QUIET_SECONDS=600

# Scheduling and reservation settings also propagate to the Docker API/worker.
# AGENT_SESSION_AFFINITY_ENABLED=true
# AGENT_SESSION_AFFINITY_TTL_SECONDS=3600
# AGENT_GATEWAY_MAX_ATTEMPTS=3
# AGENT_GATEWAY_SELECTION_POOL_SIZE=7
# AGENT_CREDENTIAL_UNHEALTHY_RETRY_SECONDS=300
# AGENT_CREDENTIAL_SOFT_RETRY_SECONDS=10
# AGENT_CREDENTIAL_FAILURE_THRESHOLD=3
# AGENT_CREDENTIAL_COOLDOWN_SECONDS=60
# AGENT_QUOTA_RESERVATION_TTL_SECONDS=3600

# Dedicated Messages search prompts can bypass conversation-model rounds.
# AGENT_WEB_SEARCH_SHORTCUT_ENABLED=true
